+}
+
+void ControllerManager::StartSocketInput()
+{
+#ifdef CHIAKI_GUI_HAVE_SOCKET_INPUT
+	const char *configured_path = getenv("CHIAKI_NG_INPUT_SOCKET");
+	const char *path = (configured_path && *configured_path) ? configured_path : CHIAKI_SOCKET_INPUT_DEFAULT_PATH;
+
+	socket_input_fd = ::socket(AF_UNIX, SOCK_DGRAM, 0);
+	if(socket_input_fd < 0)
+	{
+		qWarning("Socket input: socket() failed: %s", strerror(errno));
+		return;
+	}
+
+	struct sockaddr_un address;
+	memset(&address, 0, sizeof(address));
+	address.sun_family = AF_UNIX;
+	const size_t path_length = strlen(path);
+	if(path_length >= sizeof(address.sun_path))
+	{
+		qWarning("Socket input: path too long: %s", path);
+		::close(socket_input_fd);
+		socket_input_fd = -1;
+		return;
+	}
+	memcpy(address.sun_path, path, path_length);
+
+	// A stale socket file from a previous run would make bind() fail.
+	::unlink(path);
+	if(::bind(socket_input_fd, reinterpret_cast<struct sockaddr *>(&address), sizeof(address)) < 0)
+	{
+		qWarning("Socket input: bind(%s) failed: %s", path, strerror(errno));
+		::close(socket_input_fd);
+		socket_input_fd = -1;
+		return;
+	}
+
+	socket_input_path = QString::fromUtf8(path, static_cast<int>(path_length));
+	qInfo("Socket input: listening on %s", path);
+#endif
+}
+
+void ControllerManager::StopSocketInput()
+{
+#ifdef CHIAKI_GUI_HAVE_SOCKET_INPUT
+	if(socket_input_fd >= 0)
+	{
+		::close(socket_input_fd);
+		socket_input_fd = -1;
+	}
+	if(!socket_input_path.isEmpty())
+	{
+		::unlink(socket_input_path.toUtf8().constData());
+		socket_input_path.clear();
+	}
+#endif
+}
+
+void ControllerManager::PollSocketInput()
+{
+#ifdef CHIAKI_GUI_HAVE_SOCKET_INPUT
+	if(socket_input_fd < 0)
+		return;
+
+	const int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count();
+
+	// Drain every queued datagram.
+	for(;;)
+	{
+		ChiakiSocketInputMessage message;
+		const ssize_t received = ::recv(socket_input_fd, &message, sizeof(message), MSG_DONTWAIT);
+		if(received < 0)
+			break;
+		if(!chiaki_socket_input_validate(&message, static_cast<unsigned>(received)))
+			continue;
+
+		const uint32_t previous_buttons = socket_input_state.buttons;
+		socket_input_state.buttons = message.buttons;
+		socket_input_state.l2_state = message.l2_state;
+		socket_input_state.r2_state = message.r2_state;
+		socket_input_state.left_x = message.left_x;
+		socket_input_state.left_y = message.left_y;
+		socket_input_state.right_x = message.right_x;
+		socket_input_state.right_y = message.right_y;
+		socket_input_last_ms = static_cast<uint64_t>(now_ms);
+		socket_input_dirty = true;
+
+		// Log only on change so a 50 Hz sender does not flood the log.
+		if(message.buttons != previous_buttons)
+		{
+			qInfo("Socket input: buttons=0x%04x l2=%u r2=%u left=(%d,%d) right=(%d,%d)",
+				message.buttons & 0xFFFFu,
+				message.l2_state,
+				message.r2_state,
+				message.left_x,
+				message.left_y,
+				message.right_x,
+				message.right_y);
+		}
+	}
+
+	// Release everything once the sender goes quiet, so a client that crashes
+	// cannot leave a button stuck down.
+	if(socket_input_dirty && socket_input_last_ms != 0 &&
+		now_ms - static_cast<int64_t>(socket_input_last_ms) > SOCKET_INPUT_TIMEOUT_MS)
+	{
+		chiaki_controller_state_set_idle(&socket_input_state);
+		socket_input_last_ms = 0;
+	}
+
+	if(socket_input_dirty)
+	{
+		socket_input_dirty = false;
+		emit SocketInputStateChanged();
+	}
 #endif
 }
 
